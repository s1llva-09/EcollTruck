<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardBackgroundColor="#1A2C3D"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/img_truck_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/icon_background_green"
            android:padding="8dp"
            android:src="@drawable/ic_truck"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/txt_caminhao_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Caminhão #2301"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/img_truck_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_caminhao_placa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="ABC-1234"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/img_truck_icon"
            app:layout_constraintTop_toBottomOf="@id/txt_caminhao_id" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_ativo"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="Ativo"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#37474F"
            app:layout_constraintTop_toBottomOf="@id/img_truck_icon" />

        <ImageView
            android:id="@+id/img_motorista_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_person"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:tint="@android:color/darker_gray" />

        <TextView
            android:id="@+id/txt_motorista_nome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="João Silva"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/img_motorista_icon"
            app:layout_constraintStart_toEndOf="@id/img_motorista_icon"
            app:layout_constraintTop_toTopOf="@id/img_motorista_icon" />

        <ImageView
            android:id="@+id/img_local_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_location"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_motorista_icon"
            app:tint="@android:color/darker_gray" />

        <TextView
            android:id="@+id/txt_local_rua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Rua das Flores, 123"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/img_local_icon"
            app:layout_constraintStart_toEndOf="@id/img_local_icon"
            app:layout_constraintTop_toTopOf="@id/img_local_icon" />

        <ImageView
            android:id="@+id/img_atualizado_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_clock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_local_icon"
            app:tint="@android:color/darker_gray" />

        <TextView
            android:id="@+id/txt_atualizado_tempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Atualizado 2 min atrás"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintBottom_toBottomOf="@id/img_atualizado_icon"
            app:layout_constraintStart_toEndOf="@id/img_atualizado_icon"
            app:layout_constraintTop_toTopOf="@id/img_atualizado_icon" />

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#37474F"
            app:layout_constraintTop_toBottomOf="@id/img_atualizado_icon" />

        <ImageView
            android:id="@+id/img_rota_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_route"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:tint="@android:color/darker_gray" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Progresso da Rota"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/img_rota_icon"
            app:layout_constraintStart_toEndOf="@id/img_rota_icon"
            app:layout_constraintTop_toTopOf="@id/img_rota_icon" />

        <TextView
            android:id="@+id/txt_rota_progresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="65%"
            android:textColor="#00FF87"
            app:layout_constraintBottom_toBottomOf="@id/img_rota_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/img_rota_icon" />

        <ProgressBar
            android:id="@+id/progress_rota"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/operacionais_progress_bar"
            app:layout_constraintTop_toBottomOf="@id/img_rota_icon" />

        <View
            android:id="@+id/divider3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#37474F"
            app:layout_constraintTop_toBottomOf="@id/progress_rota" />

        <LinearLayout
            android:id="@+id/status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/divider3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Combustível"
                    android:textColor="@android:color/white" />

                <ProgressBar
                    android:id="@+id/progress_combustivel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/combustivel_progress_bar" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_combustivel_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bateria"
                    android:textColor="@android:color/white" />

                <ProgressBar
                    android:id="@+id/progress_bateria"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="92"
                    android:progressDrawable="@drawable/bateria_progress_bar" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_bateria_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="92%"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>