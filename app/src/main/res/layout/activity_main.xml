<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    tools:context=".view.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_background"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/main_menu"
            app:navigationIcon="@drawable/ic_arrow_back">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_ecolltruck"
                app:tint="@color/green_accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_waste"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/caminhao_num"
                    android:textColor="@color/hint_text"
                    android:textSize="14sp" />
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Rota do Dia Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/light_gray"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txt_rota_dia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rota_do_dia"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zona_norte_setor_residencial"
                            android:textColor="@color/hint_text"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txt_rota_dia" />

                        <ImageButton
                            android:id="@+id/btn_pause_play"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_pause"
                            android:background="@drawable/rounded_corners"
                            android:backgroundTint="@color/yellow_pause"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/progresso_da_rota"
                        android:textColor="@color/white"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="8dp"
                            android:progress="40"
                            android:progressDrawable="@drawable/custom_progress_bar"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/txt_progress_points"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/txt_progress_points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pontos"
                            android:textColor="@color/green_accent"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Mapa Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/light_gray"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/navegacao_ativa"
                        app:icon="@drawable/ic_navigation"
                        android:backgroundTint="@color/dark_gray"/>

                    <!-- Mapa Simulado -->

                    <!-- Legenda -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/rounded_corners"
                        android:backgroundTint="@color/dark_blue_map"
                        android:padding="16dp">

                        <!-- Linhas de Conexão -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:background="@color/green_accent"
                            app:layout_constraintBottom_toTopOf="@id/point_b"
                            app:layout_constraintEnd_toEndOf="@id/point_a"
                            app:layout_constraintStart_toStartOf="@id/point_a"
                            app:layout_constraintTop_toBottomOf="@id/point_a" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:background="@color/green_accent"
                            app:layout_constraintBottom_toBottomOf="@id/point_b"
                            app:layout_constraintEnd_toStartOf="@id/truck_current_location"
                            app:layout_constraintStart_toEndOf="@id/point_b"
                            app:layout_constraintTop_toTopOf="@id/point_b" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:background="@drawable/dotted_line"
                            app:layout_constraintBottom_toBottomOf="@id/truck_current_location"
                            app:layout_constraintEnd_toStartOf="@id/point_c"
                            app:layout_constraintStart_toEndOf="@id/truck_current_location"
                            app:layout_constraintTop_toTopOf="@id/truck_current_location" />

                        <View
                            android:id="@+id/view"
                            android:layout_width="27dp"
                            android:layout_height="25dp"
                            android:background="@drawable/dotted_line"
                            android:rotation="242"
                            app:layout_constraintBottom_toTopOf="@+id/point_e"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.954"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/label_point_d"
                            app:layout_constraintVertical_bias="0.0" />

                        <View
                            android:layout_width="69dp"
                            android:layout_height="49dp"
                            android:background="@drawable/dotted_line"
                            android:rotation="104"
                            app:layout_constraintBottom_toTopOf="@+id/point_c"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.857"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/label_point_d"
                            app:layout_constraintVertical_bias="0.516" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:background="@drawable/dotted_line"
                            app:layout_constraintBottom_toTopOf="@id/point_d"
                            app:layout_constraintEnd_toEndOf="@id/point_c"
                            app:layout_constraintStart_toStartOf="@id/point_c"
                            app:layout_constraintTop_toBottomOf="@id/point_c" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:background="@drawable/dotted_line"
                            app:layout_constraintBottom_toBottomOf="@id/point_d"
                            app:layout_constraintEnd_toEndOf="@id/point_d"
                            app:layout_constraintStart_toStartOf="@id/point_e"
                            app:layout_constraintTop_toTopOf="@id/point_d" />


                        <!-- Pontos do Mapa -->

                        <ImageView
                            android:id="@+id/point_a"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_map_point_completed"
                            tools:layout_editor_absoluteX="23dp"
                            tools:layout_editor_absoluteY="72dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ponto_a"
                            android:textColor="@color/hint_text"
                            app:layout_constraintEnd_toEndOf="@id/point_a"
                            app:layout_constraintStart_toStartOf="@id/point_a"
                            app:layout_constraintTop_toBottomOf="@id/point_a" />

                        <ImageView
                            android:id="@+id/point_b"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_map_point_completed"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="@id/point_a"
                            app:layout_constraintTop_toBottomOf="@id/point_a" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ponto_b"
                            android:textColor="@color/hint_text"
                            app:layout_constraintEnd_toEndOf="@id/point_b"
                            app:layout_constraintStart_toStartOf="@id/point_b"
                            app:layout_constraintTop_toBottomOf="@id/point_b" />

                        <ImageView
                            android:id="@+id/truck_current_location"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="60dp"
                            android:background="@drawable/map_current_point_background"
                            android:padding="8dp"
                            android:src="@drawable/ic_truck"
                            app:layout_constraintBottom_toBottomOf="@id/point_b"
                            app:layout_constraintStart_toEndOf="@id/point_b"
                            app:layout_constraintTop_toTopOf="@id/point_b"
                            app:layout_constraintVertical_bias="0.437"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rounded_corners"
                            android:backgroundTint="@color/green_accent"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/voce_esta_aqui"
                            android:textColor="@color/dark_background"
                            app:layout_constraintEnd_toEndOf="@id/truck_current_location"
                            app:layout_constraintStart_toStartOf="@id/truck_current_location"
                            app:layout_constraintTop_toBottomOf="@id/truck_current_location" />

                        <ImageView
                            android:id="@+id/point_c"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="48dp"
                            android:src="@drawable/ic_map_point_pending"
                            app:layout_constraintBottom_toBottomOf="@id/truck_current_location"
                            app:layout_constraintStart_toEndOf="@id/truck_current_location"
                            app:layout_constraintTop_toTopOf="@id/truck_current_location"
                            app:layout_constraintVertical_bias="0.0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ponto_c"
                            android:textColor="@color/hint_text"
                            app:layout_constraintEnd_toEndOf="@id/point_c"
                            app:layout_constraintStart_toStartOf="@id/point_c"
                            app:layout_constraintTop_toBottomOf="@id/point_c" />

                        <ImageView
                            android:id="@+id/point_d"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="32dp"
                            android:src="@drawable/ic_map_point_pending"
                            app:layout_constraintBottom_toTopOf="@id/point_c"
                            app:layout_constraintEnd_toEndOf="@id/point_e"
                            app:layout_constraintStart_toStartOf="@id/point_c"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0" />

                        <TextView
                            android:id="@+id/label_point_d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ponto_d"
                            android:textColor="@color/hint_text"
                            app:layout_constraintEnd_toEndOf="@id/point_d"
                            app:layout_constraintStart_toStartOf="@id/point_d"
                            app:layout_constraintTop_toBottomOf="@id/point_d" />

                        <ImageView
                            android:id="@+id/point_e"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_map_point_pending"
                            app:layout_constraintBottom_toBottomOf="@id/point_c"
                            app:layout_constraintStart_toEndOf="@id/point_d"
                            app:layout_constraintTop_toTopOf="@id/point_d"
                            app:layout_constraintVertical_bias="0.641" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ponto_e"
                            android:textColor="@color/hint_text"
                            app:layout_constraintEnd_toEndOf="@id/point_e"
                            app:layout_constraintStart_toStartOf="@id/point_e"
                            app:layout_constraintTop_toBottomOf="@id/point_e" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_map_point_completed"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/concluido"
                            android:textColor="@color/white"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="24dp"
                            android:src="@drawable/ic_map_point_pending"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/pendente"
                            android:textColor="@color/white"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="24dp"
                            android:src="@drawable/ic_truck"
                            app:tint="@color/green_accent" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/atual"
                            android:textColor="@color/white"/>

                    </LinearLayout>


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pontos de Coleta Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/light_gray"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pontos de Coleta"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_ver_pontos_coleta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Ver Pontos de Coleta"
                        android:backgroundTint="@color/green_accent"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Medidor de Carga Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/light_gray"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medidor de Carga"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_ver_medidor_carga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Ver Medidor de Carga"
                        android:backgroundTint="@color/green_accent"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
